# Meson cross file: build the aarch64 guest VA-API backend from an x86_64 host (a native x86
# compiler emitting aarch64 code -- no qemu emulation anywhere). Paired with the arm64 multiarch
# environment of Dockerfile.va-cross (Ubuntu resolute, so the arm64 -dev libraries carry the
# guest's 26.04 ABI). Adapted from Droid-VM/mesa-cross's file of the same name, minus its
# llvm-config wrapper: nothing here needs a config tool of the target architecture.
[binaries]
c       = 'aarch64-linux-gnu-gcc'
cpp     = 'aarch64-linux-gnu-g++'
ar      = 'aarch64-linux-gnu-ar'
strip   = 'aarch64-linux-gnu-strip'
ld      = 'aarch64-linux-gnu-ld'
nm      = 'aarch64-linux-gnu-nm'
objcopy = 'aarch64-linux-gnu-objcopy'
objdump = 'aarch64-linux-gnu-objdump'
ranlib  = 'aarch64-linux-gnu-ranlib'
readelf = 'aarch64-linux-gnu-readelf'
pkg-config = 'pkg-config'
# Host tools invoked at build time run natively on x86:
python  = 'python3'

[host_machine]
system     = 'linux'
cpu_family = 'aarch64'
cpu        = 'aarch64'
endian     = 'little'

[properties]
# Cross pkg-config only ever looks at the arm64 packages: Debian multiarch puts them in the
# compiler's normal search path, so this is the whole of the cross setup.
pkg_config_libdir = '/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig'
# Skip any run-time detection that would need to execute an aarch64 binary.
needs_exe_wrapper = true
